# EasyPanel -> servico Compose -> Environment -> marque Create .env file.
# Copie apenas os nomes necessarios e defina os valores reais no EasyPanel.
# Nunca salve o arquivo preenchido no repositorio ou no workspace local.

# Infraestrutura
DATABASE_URL=
REDIS_PASSWORD=CHANGE_ME
WAHA_API_KEY=CHANGE_ME

# URLs publicas
APP_PUBLIC_URL=https://app.example.com
API_URL=https://api.example.com
CORS_ORIGIN=https://app.example.com
NEXT_PUBLIC_WS_URL=wss://api.example.com/ws
NEXT_PUBLIC_APP_NAME=NexaFlow

# Autenticacao e criptografia
JWT_SECRET=CHANGE_ME_GENERATE_RANDOM_64_CHARS
COOKIE_SECRET=CHANGE_ME_GENERATE_RANDOM_64_CHARS
ENCRYPTION_KEY=CHANGE_ME_GENERATE_RANDOM_64_CHARS
WHATSAPP_VERIFY_TOKEN=CHANGE_ME
TRUST_PROXY=true
SUPERADMIN_MFA_REQUIRED=1
AUTH_LOGIN_MAINTENANCE=0
RUN_SEED_ON_BOOT=0

# E-mail
MAIL_PROVIDER=log
ALLOW_MAIL_DISABLED=1
MAIL_API_KEY=
MAIL_FROM=NexaFlow <noreply@example.com>

# IA (opcional)
GROQ_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=
SALES_EMAIL=
