POSTGRES_PASSWORD=
CHANGE_ME
DATABASE_URL=postgresql://nexaflow:CHANGE_ME@i9atendimento_postgres-main:5432/nexaflow?schema=public

REDIS_PASSWORD=
CHANGE_ME

WAHA_API_KEY=
CHANGE_ME

APP_PUBLIC_URL=https://i9atendimento-nexaflow.kuso1a.easypanel.host
API_URL=https://i9atendimento-nexaflow-api.kuso1a.easypanel.host
