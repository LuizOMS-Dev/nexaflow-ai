# EasyPanel → serviço Compose → Environment → marque Create .env file.
# Preencha com valores exclusivos. Nunca commitar o arquivo preenchido.

POSTGRES_USER=nexaflow
POSTGRES_PASSWORD=
POSTGRES_DB=nexaflow
DATABASE_URL=postgresql://nexaflow:<URL_ENCODE_DA_SENHA>@postgres:5432/nexaflow?schema=public

REDIS_PASSWORD=
REDIS_URL=redis://:<URL_ENCODE_DA_SENHA>@redis:6379

WAHA_API_KEY=
WA_GATEWAY_API_KEY=

APP_PUBLIC_URL=https://i9atendimento-nexaflow.kuso1a.easypanel.host
API_URL=https://i9atendimento-nexaflow-api.kuso1a.easypanel.host
CORS_ORIGIN=https://i9atendimento-nexaflow.kuso1a.easypanel.host
NEXT_PUBLIC_WS_URL=wss://i9atendimento-nexaflow-api.kuso1a.easypanel.host/ws
NEXT_PUBLIC_APP_NAME=NexaFlow

JWT_SECRET=
COOKIE_SECRET=
ENCRYPTION_KEY=
WHATSAPP_VERIFY_TOKEN=

TRUST_PROXY=true
SUPERADMIN_MFA_REQUIRED=1
AUTH_LOGIN_MAINTENANCE=0
RUN_SEED_ON_BOOT=0

# Sem provedor de e-mail ainda: a API sobe, convite/reset ficam pendentes.
MAIL_PROVIDER=log
ALLOW_MAIL_DISABLED=1
MAIL_API_KEY=
MAIL_FROM=NexaFlow <noreply@i9atendimento.com.br>

GROQ_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=
SALES_EMAIL=
