{
  "name": "nexaflow-ai",
  "version": "1.0.0",
  "private": true,
  "description": "NexaFlow AI — atendimento, CRM e agentes de IA para WhatsApp",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "node scripts/setup.js",
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev -w @nexaflow/api\" \"npm run dev -w @nexaflow/web\"",
    "dev:api": "npm run dev -w @nexaflow/api",
    "dev:web": "npm run dev -w @nexaflow/web",
    "build": "npm run build -w @nexaflow/db && npm run build -w @nexaflow/api && npm run build -w @nexaflow/web",
    "start:api": "npm run start -w @nexaflow/api",
    "start:web": "npm run start -w @nexaflow/web",
    "db:generate": "npm run generate -w @nexaflow/db",
    "db:migrate": "npm run migrate -w @nexaflow/db",
    "db:migrate:deploy": "npm run migrate:deploy -w @nexaflow/db",
    "db:push": "npm run push -w @nexaflow/db",
    "db:seed": "npm run seed -w @nexaflow/db",
    "db:studio": "npm run studio -w @nexaflow/db",
    "test": "npm run test -w @nexaflow/api",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "security:check": "npm run security:check -w @nexaflow/api",
    "docker:up": "powershell -NoProfile -File scripts/docker/up.ps1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "concurrently": "^9.2.5"
  },
  "engines": {
    "node": ">=22"
  }
}
