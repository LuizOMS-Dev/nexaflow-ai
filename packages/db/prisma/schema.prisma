generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Postgres em Docker/produção. Dev local: use DATABASE_URL postgresql://...
  // (SQLite legado via file: só em testes isolados com schema de teste)
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===================== PLATFORM =====================

enum PlatformRole {
  SUPERADMIN
}

enum TenantStatus {
  ACTIVE
  TRIAL
  /// Bloqueio administrativo temporário (dados preservados)
  BLOCKED
  SUSPENDED
  CANCELLED
  /// Soft-delete: exclusão solicitada; dados ainda preservados
  PENDING_DELETION
}

enum MemberRole {
  ADMIN
  SUPERVISOR
  AGENT
  SALES
  READONLY
}

/// Como o usuário se apresenta visualmente
enum AvatarType {
  UPLOAD
  INITIALS
  NEXA_AVATAR
}

enum ChannelType {
  WHATSAPP
  INSTAGRAM
  MESSENGER
  TELEGRAM
  EMAIL
  WEBCHAT
  FORM
  WEBHOOK
  API
  INTERNAL
}

enum ConversationStatus {
  OPEN
  PENDING
  CLOSED
  ARCHIVED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
  INTERNAL
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  LOCATION
  TEMPLATE
  SYSTEM
}

/// Status comercial do lead/contato (substitui quente/morno/frio)
enum LeadStatus {
  NOVO
  EM_ANALISE
  QUALIFICADO
  NAO_QUALIFICADO
  EM_NEGOCIACAO
  CLIENTE
  PERDIDO
  NUTRICAO
}

/// Prioridade de atendimento do lead
enum LeadPriority {
  BAIXA
  NORMAL
  ALTA
  URGENTE
}

/// Etapa do contato comercial gerado pelo site público da NexaFlow.
enum SalesLeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  WON
  LOST
  SPAM
}

enum OpportunityStatus {
  OPEN
  WON
  LOST
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AiMode {
  SUGGEST
  APPROVE
  AUTO
}

/// Publicação do agente (versionamento)
enum AgentPublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum KnowledgeGapStatus {
  NEW
  REVIEWING
  RESOLVED
  IGNORED
}

enum LearningSuggestionStatus {
  PENDING
  APPROVED
  REJECTED
  ARCHIVED
}

enum AgentToolExecStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  REJECTED
  NEEDS_APPROVAL
}

enum AgentTestResult {
  PASS
  FAIL
  WARNING
  SKIPPED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
}

enum AutomationStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

model Plan {
  id               String         @id @default(cuid())
  name             String
  slug             String         @unique
  description      String?
  /// Preço de catálogo mensal (BRL). Enterprise pode ser 0 + priceOnRequest.
  priceMonthly     Decimal        @default(0)
  /// Preço anual de catálogo (BRL). Opcional; se nulo, UI pode calcular desconto padrão.
  priceAnnual      Decimal?
  /// Preço sob consulta (Enterprise)
  priceOnRequest   Boolean        @default(false)
  maxUsers         Int            @default(1)
  maxChannels      Int            @default(1)
  maxContacts      Int            @default(500)
  maxConversations Int            @default(1000)
  /// Créditos de IA / mês (unidade operacional = 1 chamada assistida)
  maxAiMessages    Int            @default(100)
  /// Entitlements extras: maxAgents, maxActiveFlows, monthlyAiCredits, flags de feature
  features         Json?
  /// popular | null
  badge            String?
  sortOrder        Int            @default(0)
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  tenants          Tenant[]
  subscriptions    Subscription[]
}

model Tenant {
  id           String       @id @default(cuid())
  name         String
  slug         String       @unique
  status       TenantStatus @default(TRIAL)
  logoUrl      String?
  primaryColor String       @default("#6366f1")
  domain       String?
  planId       String?
  plan         Plan?        @relation(fields: [planId], references: [id])
  trialEndsAt  DateTime?
  settings     Json?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  members             Membership[]
  contacts            Contact[]
  conversations       Conversation[]
  tags                Tag[]
  pipelines           Pipeline[]
  opportunities       Opportunity[]
  tasks               Task[]
  quickReplies        QuickReply[]
  channels            Channel[]
  aiAgents            AiAgent[]
  knowledgeDocs       KnowledgeDoc[]
  automations         Automation[]
  campaigns           Campaign[]
  auditLogs           AuditLog[]
  webhooks            WebhookEndpoint[]
  apiKeys             ApiKey[]
  customFields        CustomField[]
  agentToolExecutions AgentToolExecution[]
  agentVersions       AgentVersion[]
  knowledgeGaps       KnowledgeGap[]
  learningSuggestions LearningSuggestion[]
  agentFeedbacks      AgentFeedback[]
  agentTestCases      AgentTestCase[]
  agentTestRuns       AgentTestRun[]
  /// Config de provedor de IA do tenant (BYOK / padrão)
  aiConfig            TenantAiConfig?
}

/// Configuração de provedor de IA por empresa (BYOK).
/// API key criptografada (enc:v1:...). Nunca retornar plaintext no GET.
model TenantAiConfig {
  id               String    @id @default(cuid())
  tenantId         String    @unique
  /// openai | groq | xai | openrouter | mistral | anthropic | gemini
  provider         String    @default("groq")
  model            String    @default("llama-3.1-8b-instant")
  /// platform_managed | byok
  credentialMode   String    @default("platform_managed")
  /// AES-GCM — null se platform_managed
  apiKeyEnc        String?
  /// últimos 4 chars para UI
  apiKeyLast4      String?
  baseUrl          String?
  fallbackProvider String?
  fallbackModel    String?
  enabled          Boolean   @default(true)
  lastTestedAt     DateTime?
  lastTestOk       Boolean?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([provider])
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DISABLED
  PENDING_VERIFICATION
}

model User {
  id                   String        @id @default(cuid())
  email                String        @unique
  passwordHash         String
  name                 String
  /// URL pública do upload (/media/avatars/...) ou null
  avatarUrl            String?
  /// UPLOAD | INITIALS | NEXA_AVATAR
  avatarType           AvatarType    @default(INITIALS)
  /// ID de preset Nexa (ex.: nexa-fox-01) — só se avatarType = NEXA_AVATAR
  avatarPresetId       String?
  /// Cor do fundo das iniciais (hex ou token)
  avatarColor          String?
  phone                String?
  /// Preferências pessoais (tema, notificações, idioma…)
  preferences          Json?
  platformRole         PlatformRole?
  status               UserStatus    @default(ACTIVE)
  isActive             Boolean       @default(true)
  /// Secret TOTP cifrado em repouso (AES-256-GCM). Prefixo de versão: enc:v1:...
  twoFactorSecret      String?
  twoFactorEnabled     Boolean       @default(false)
  /// JSON array de hashes de códigos de recuperação (uso único)
  twoFactorBackupCodes String?
  /// Último timestep TOTP aceito (anti-replay)
  lastTotpStep         Int?
  /// Última autenticação forte (login/MFA/step-up) — step-up auth
  lastStrongAuthAt     DateTime?
  lastLoginAt          DateTime?
  passwordChangedAt    DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  memberships           Membership[]
  assignedConversations Conversation[]       @relation("AssignedAgent")
  messages              Message[]            @relation("MessageAuthor")
  tasksAssigned         Task[]               @relation("TaskAssignee")
  tasksCreated          Task[]               @relation("TaskCreator")
  notes                 Note[]
  auditLogs             AuditLog[]
  refreshTokens         RefreshToken[]
  authSessions          AuthSession[]
  loginAttempts         LoginAttempt[]
  passwordResets        PasswordResetToken[]
  securityEvents        SecurityEvent[]      @relation("SecurityEventUser")
  mfaChallenges         MfaChallenge[]
  releaseSeen           UserReleaseSeen[]
}

model Membership {
  id        String     @id @default(cuid())
  tenantId  String
  userId    String
  role      MemberRole @default(AGENT)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Sessão autenticada + refresh token rotativo (só hash no banco)
model AuthSession {
  id                     String    @id @default(cuid())
  userId                 String
  tenantId               String?
  refreshTokenHash       String    @unique
  familyId               String
  createdAt              DateTime  @default(now())
  expiresAt              DateTime
  lastActivityAt         DateTime  @default(now())
  ip                     String?
  userAgent              String?
  deviceLabel            String?
  revokedAt              DateTime?
  revokeReason           String?
  /// Superadmin que iniciou a impersonação (se houver)
  impersonatorId         String?
  isImpersonation        Boolean   @default(false)
  /// Motivo obrigatório da impersonação
  impersonationReason    String?
  /// Expiração máxima da impersonação (hard cap)
  impersonationExpiresAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([tenantId])
  @@index([expiresAt])
  @@index([impersonatorId])
}

/// Desafio MFA de curta duração após senha correta (login em 2 passos)
model MfaChallenge {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  createdAt   DateTime  @default(now())
  ip          String?
  tenantId    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  userId    String?
  ip        String?
  userAgent String?
  success   Boolean  @default(false)
  reason    String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  ip        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Convite de membro — usuário define a própria senha (sem senha default do admin)
model UserInvite {
  id          String     @id @default(cuid())
  tenantId    String
  email       String
  name        String
  role        MemberRole @default(AGENT)
  tokenHash   String     @unique
  invitedById String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime   @default(now())

  @@index([tenantId])
  @@index([email])
  @@index([expiresAt])
}

model SecurityEvent {
  id        String   @id @default(cuid())
  type      String
  userId    String?
  tenantId  String?
  ip        String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation("SecurityEventUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([type, createdAt])
  @@index([userId])
  @@index([tenantId])
}

// ===================== CRM / CONTACTS =====================

model Contact {
  id                String       @id @default(cuid())
  tenantId          String
  name              String
  phone             String?
  email             String?
  document          String?
  company           String?
  jobTitle          String?
  city              String?
  state             String?
  country           String       @default("BR")
  birthDate         DateTime?
  source            String?
  avatarUrl         String?
  notes             String?
  customData        Json?
  /// Score 0–100 com breakdown em scoreBreakdown
  score             Int          @default(0)
  /// [{ "factor": "...", "delta": 10, "label": "..." }]
  scoreBreakdown    Json?
  scoreUpdatedAt    DateTime?
  commercialStatus  LeadStatus   @default(NOVO)
  priority          LeadPriority @default(NORMAL)
  nextAction        String?
  nextActionDueAt   DateTime?
  stage             String?
  consentMarketing  Boolean      @default(false)
  consentWhatsapp   Boolean      @default(false)
  lastInteractionAt DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tags          ContactTag[]
  conversations Conversation[]
  opportunities Opportunity[]
  tasks         Task[]
  notesList     Note[]
  memory        ContactMemory?
  scoreHistory  ContactScoreHistory[]

  @@index([tenantId])
  @@index([tenantId, phone])
  @@index([tenantId, email])
  @@index([tenantId, name])
}

/// Histórico de evolução do score comercial (auditável)
model ContactScoreHistory {
  id            String   @id @default(cuid())
  tenantId      String
  contactId     String
  previousScore Int
  newScore      Int
  breakdown     Json?
  /// AI | RULE | MANUAL | AUTOMATION
  source        String   @default("MANUAL")
  note          String?
  createdAt     DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId, createdAt])
  @@index([tenantId])
}

/// Decisões do usuário sobre recomendações (dedupe + estado)
model RecommendationDecision {
  id          String    @id @default(cuid())
  tenantId    String
  userId      String
  /// chave estável ex.: waiting-reply, wa-down
  key         String
  /// OPEN | RESOLVED | IGNORED | SNOOZED
  status      String    @default("OPEN")
  note        String?
  snoozeUntil DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([tenantId, userId, key])
  @@index([tenantId, status])
}

model ContactMemory {
  id        String   @id @default(cuid())
  contactId String   @unique
  content   Json?
  summary   String?
  updatedAt DateTime @updatedAt
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
}

model Tag {
  id        String       @id @default(cuid())
  tenantId  String
  name      String
  color     String       @default("#6366f1")
  createdAt DateTime     @default(now())
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contacts  ContactTag[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model ContactTag {
  contactId String
  tagId     String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
}

model CustomField {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  key       String
  type      String   @default("text")
  options   Json?
  required  Boolean  @default(false)
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
}

// ===================== CHANNELS & INBOX =====================

model Channel {
  id         String      @id @default(cuid())
  tenantId   String
  type       ChannelType
  name       String
  isActive   Boolean     @default(true)
  config     Json?
  externalId String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@index([tenantId])
  @@index([tenantId, type])
}

model Conversation {
  id                 String             @id @default(cuid())
  tenantId           String
  contactId          String
  channelId          String?
  status             ConversationStatus @default(OPEN)
  subject            String?
  assignedToId       String?
  priority           Int                @default(0)
  isUnread           Boolean            @default(true)
  isFavorite         Boolean            @default(false)
  aiSummary          String?
  aiSentiment        String?
  aiIntent           String?
  aiScore            Int?
  lastMessageAt      DateTime?
  lastMessagePreview String?
  closedAt           DateTime?
  /**
   * Motivo legível de produto: COMPLETED | NO_RESPONSE | AI_RESOLVED | …
   */
  closeReason        String?
  /**
   * human | inactivity | ai
   */
  closeSource        String?
  closedById         String?
  closeNote          String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact    Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  channel    Channel?  @relation(fields: [channelId], references: [id])
  assignedTo User?     @relation("AssignedAgent", fields: [assignedToId], references: [id])
  messages   Message[]
  notes      Note[]
  tasks      Task[]

  @@index([tenantId, status])
  @@index([tenantId, assignedToId])
  @@index([tenantId, lastMessageAt])
  @@index([contactId])
  @@index([tenantId, status, lastMessageAt])
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  authorId       String?
  direction      MessageDirection
  type           MessageType      @default(TEXT)
  content        String
  mediaUrl       String?
  metadata       Json?
  externalId     String?
  isAiGenerated  Boolean          @default(false)
  aiApproved     Boolean?
  readAt         DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime         @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       User?        @relation("MessageAuthor", fields: [authorId], references: [id])

  @@index([conversationId, createdAt])
}

model Note {
  id             String   @id @default(cuid())
  tenantId       String?
  conversationId String?
  contactId      String?
  authorId       String
  content        String
  createdAt      DateTime @default(now())

  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  contact      Contact?      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  author       User          @relation(fields: [authorId], references: [id])

  @@index([conversationId])
  @@index([contactId])
}

model QuickReply {
  id        String   @id @default(cuid())
  tenantId  String
  title     String
  content   String
  shortcut  String?
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// ===================== PIPELINE / CRM =====================

model Pipeline {
  id            String          @id @default(cuid())
  tenantId      String
  name          String
  isDefault     Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stages        PipelineStage[]
  opportunities Opportunity[]

  @@index([tenantId])
}

model PipelineStage {
  id            String        @id @default(cuid())
  pipelineId    String
  name          String
  color         String        @default("#6366f1")
  position      Int           @default(0)
  probability   Int           @default(0)
  isWon         Boolean       @default(false)
  isLost        Boolean       @default(false)
  pipeline      Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]

  @@index([pipelineId])
}

model Opportunity {
  id             String            @id @default(cuid())
  tenantId       String
  pipelineId     String
  stageId        String
  contactId      String
  title          String
  value          Decimal           @default(0)
  probability    Int               @default(0)
  status         OpportunityStatus @default(OPEN)
  source         String?
  product        String?
  expectedClose  DateTime?
  lostReason     String?
  notes          String?
  lastActivityAt DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  tenant   Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pipeline Pipeline             @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage    PipelineStage        @relation(fields: [stageId], references: [id])
  contact  Contact              @relation(fields: [contactId], references: [id], onDelete: Cascade)
  history  OpportunityHistory[]

  @@index([tenantId, pipelineId])
  @@index([stageId])
  @@index([contactId])
}

model OpportunityHistory {
  id            String      @id @default(cuid())
  opportunityId String
  fromStageId   String?
  toStageId     String?
  action        String
  note          String?
  createdAt     DateTime    @default(now())
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId])
}

// ===================== TASKS =====================

model Task {
  id             String       @id @default(cuid())
  tenantId       String
  title          String
  description    String?
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  dueAt          DateTime?
  assigneeId     String?
  creatorId      String?
  contactId      String?
  conversationId String?
  checklist      Json?
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignee     User?         @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creator      User?         @relation("TaskCreator", fields: [creatorId], references: [id])
  contact      Contact?      @relation(fields: [contactId], references: [id])
  conversation Conversation? @relation(fields: [conversationId], references: [id])

  @@index([tenantId, status])
  @@index([assigneeId])
}

// ===================== AI =====================

model AiAgent {
  id             String             @id @default(cuid())
  tenantId       String
  name           String
  role           String?
  objective      String?
  personality    String?
  tone           String?
  language       String             @default("pt-BR")
  instructions   String             @default("")
  restrictions   String?
  mode           AiMode             @default(SUGGEST)
  model          String             @default("llama-3.3-70b-versatile")
  temperature    Float              @default(0.4)
  maxMessages    Int                @default(50)
  isActive       Boolean            @default(true)
  greeting       String?
  farewell       String?
  transferRules  Json?
  tools          Json?
  /// DRAFT | PUBLISHED | ARCHIVED — comportamento ativo só com PUBLISHED + isActive
  publishStatus  AgentPublishStatus @default(PUBLISHED)
  /// Número da versão publicada atual
  currentVersion Int                @default(1)
  /// Rascunho de edição (snapshot) sem afetar produção
  draftSnapshot  Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  versions            AgentVersion[]
  toolExecutions      AgentToolExecution[]
  knowledgeGaps       KnowledgeGap[]
  learningSuggestions LearningSuggestion[]
  feedbacks           AgentFeedback[]
  testCases           AgentTestCase[]
  testRuns            AgentTestRun[]
  knowledgeLinks      AgentKnowledge[]

  @@index([tenantId])
  @@index([tenantId, publishStatus])
}

/// Snapshot imutável de uma versão publicada do agente
model AgentVersion {
  id          String   @id @default(cuid())
  tenantId    String
  agentId     String
  version     Int
  snapshot    Json
  changeNote  String?
  createdById String?
  createdAt   DateTime @default(now())

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agent  AiAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, version])
  @@index([tenantId, agentId])
}

/// Execução de tool do agente (auditoria + APPROVE de ações)
model AgentToolExecution {
  id               String              @id @default(cuid())
  tenantId         String
  agentId          String?
  conversationId   String?
  contactId        String?
  toolName         String
  input            Json?
  result           Json?
  status           AgentToolExecStatus @default(PENDING)
  requiresApproval Boolean             @default(false)
  approvedById     String?
  error            String?
  createdAt        DateTime            @default(now())
  completedAt      DateTime?

  tenant Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agent  AiAgent? @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, agentId])
  @@index([conversationId])
}

/// Lacuna de conhecimento detectada
model KnowledgeGap {
  id            String             @id @default(cuid())
  tenantId      String
  agentId       String?
  question      String
  normalizedKey String
  occurrences   Int                @default(1)
  status        KnowledgeGapStatus @default(NEW)
  lastSeenAt    DateTime           @default(now())
  resolvedAt    DateTime?
  metadata      Json?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  tenant Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agent  AiAgent? @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@unique([tenantId, normalizedKey])
  @@index([tenantId, status])
  @@index([tenantId, agentId])
}

/// Sugestão de aprendizado (não auto-publica sem policy)
model LearningSuggestion {
  id           String                   @id @default(cuid())
  tenantId     String
  agentId      String?
  kind         String
  title        String
  content      String
  source       String?
  occurrences  Int                      @default(1)
  status       LearningSuggestionStatus @default(PENDING)
  metadata     Json?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  tenant Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agent  AiAgent? @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([tenantId, agentId])
}

/// Feedback interno sobre resposta da IA
model AgentFeedback {
  id             String   @id @default(cuid())
  tenantId       String
  agentId        String?
  conversationId String?
  messageId      String?
  rating         String
  reason         String?
  note           String?
  createdById    String?
  createdAt      DateTime @default(now())

  tenant Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agent  AiAgent? @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, agentId])
}

/// Caso de teste configurável do agente
model AgentTestCase {
  id           String   @id @default(cuid())
  tenantId     String
  agentId      String
  name         String
  input        String
  expectations Json?
  isRequired   Boolean  @default(false)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agent  AiAgent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  runs   AgentTestRun[]

  @@index([tenantId, agentId])
}

model AgentTestRun {
  id         String          @id @default(cuid())
  tenantId   String
  agentId    String
  testCaseId String?
  result     AgentTestResult
  reply      String?
  details    Json?
  createdAt  DateTime        @default(now())

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agent    AiAgent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  testCase AgentTestCase? @relation(fields: [testCaseId], references: [id], onDelete: SetNull)

  @@index([tenantId, agentId, createdAt])
}

/// Base de conhecimento central do tenant (não duplicar por agente).
/// status: draft | ready | archived | published (legado → ready)
/// sourceType: manual | document | system | import | text | gap | learning
/// scope: all | agents  (agents = só via AgentKnowledge)
model KnowledgeDoc {
  id         String    @id @default(cuid())
  tenantId   String
  title      String
  content    String
  category   String?
  sourceType String    @default("manual")
  sourceUrl  String?
  status     String    @default("ready")
  /// all = todos os agentes do tenant; agents = só os vinculados
  scope      String    @default("all")
  /// Última sincronização (conteúdo SYSTEM)
  syncedAt   DateTime?
  version    Int       @default(1)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chunks     KnowledgeChunk[]
  agentLinks AgentKnowledge[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, sourceType])
}

/// Vínculo N:N Knowledge ↔ Agente (sem duplicar conteúdo)
model AgentKnowledge {
  id             String   @id @default(cuid())
  tenantId       String
  knowledgeDocId String
  agentId        String
  createdAt      DateTime @default(now())

  knowledgeDoc KnowledgeDoc @relation(fields: [knowledgeDocId], references: [id], onDelete: Cascade)
  agent        AiAgent      @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([knowledgeDocId, agentId])
  @@index([tenantId, agentId])
  @@index([tenantId, knowledgeDocId])
}

model KnowledgeChunk {
  id        String       @id @default(cuid())
  docId     String
  content   String
  // embedding stored via raw SQL with pgvector when available
  metadata  Json?
  createdAt DateTime     @default(now())
  doc       KnowledgeDoc @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@index([docId])
}

// ===================== AUTOMATIONS & CAMPAIGNS =====================

model Automation {
  id          String           @id @default(cuid())
  tenantId    String
  name        String
  description String?
  status      AutomationStatus @default(DRAFT)
  trigger     Json?
  definition  Json?
  version     Int              @default(1)
  lastRunAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runs   AutomationRun[]

  @@index([tenantId])
}

model AutomationRun {
  id           String     @id @default(cuid())
  automationId String
  status       String
  payload      Json?
  result       Json?
  error        String?
  createdAt    DateTime   @default(now())
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId])
}

model Campaign {
  id          String         @id @default(cuid())
  tenantId    String
  name        String
  channelType ChannelType?
  status      CampaignStatus @default(DRAFT)
  message     String
  segment     Json?
  scheduledAt DateTime?
  stats       Json?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// ===================== WEBHOOKS & AUDIT =====================

/// Endpoint de webhook outbound por tenant (eventos NexaFlow → sistema externo)
model WebhookEndpoint {
  id             String            @id @default(cuid())
  tenantId       String
  name           String
  description    String?
  url            String
  /// Secret HMAC (armazenado; exibido só na criação/rotação)
  secret         String
  /// Lista de event types: string[]
  events         Json?
  isActive       Boolean           @default(true)
  /// active | paused | failing
  healthStatus   String            @default("active")
  failureCount   Int               @default(0)
  lastSuccessAt  DateTime?
  lastFailureAt  DateTime?
  lastDeliveryAt DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveries     WebhookDelivery[]

  @@index([tenantId])
  @@index([tenantId, isActive])
}

model WebhookDelivery {
  id           String          @id @default(cuid())
  endpointId   String
  tenantId     String
  /// ID estável do evento (idempotência entre retries)
  eventId      String
  event        String
  payload      Json?
  statusCode   Int?
  success      Boolean         @default(false)
  error        String?
  attempts     Int             @default(0)
  durationMs   Int?
  responseBody String?
  /// pending | success | failed | retrying
  status       String          @default("pending")
  nextRetryAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  endpoint     WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId, createdAt])
  @@index([tenantId, createdAt])
  @@index([eventId])
  @@index([status, nextRetryAt])
}

/// Chave de API programática por tenant (hash do secret; plaintext só na criação)
model ApiKey {
  id          String        @id @default(cuid())
  tenantId    String
  name        String
  /// Prefixo público ex.: nxf_live_ab12… (para identificação)
  keyPrefix   String
  /// SHA-256 hex do secret completo
  keyHash     String        @unique
  /// Escopos: string[]
  scopes      Json?
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  usageLogs   ApiUsageLog[]

  @@index([tenantId])
  @@index([tenantId, revokedAt])
}

model ApiUsageLog {
  id         String   @id @default(cuid())
  tenantId   String
  apiKeyId   String?
  method     String
  path       String
  statusCode Int
  durationMs Int?
  ip         String?
  createdAt  DateTime @default(now())
  apiKey     ApiKey?  @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([apiKeyId, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String?
  userId    String?
  action    String
  entity    String?
  entityId  String?
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([userId])
}

model PlatformSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json?
  updatedAt DateTime @updatedAt
}

/// Notificação in-app (por usuário + tenant opcional)
model Notification {
  id         String    @id @default(cuid())
  userId     String
  tenantId   String?
  /// CONVERSATION_ASSIGNED | TASK_OVERDUE | CHANNEL_DISCONNECTED | ...
  type       String
  title      String
  body       String?
  /// URL para abrir o recurso (alias actionUrl)
  href       String?
  actionUrl  String?
  entityType String?
  entityId   String?
  /// chave de dedupe (tenant+user+type+entity)
  dedupeKey  String?
  readAt     DateTime?
  metadata   Json?
  createdAt  DateTime  @default(now())

  @@index([userId, readAt])
  @@index([tenantId])
  @@index([createdAt])
  @@index([userId, dedupeKey])
}

/// Assinatura / cobrança (manual agora; gateways depois)
model Subscription {
  id               String    @id @default(cuid())
  tenantId         String    @unique
  planId           String?
  plan             Plan?     @relation(fields: [planId], references: [id])
  /// TRIAL | ACTIVE | PAST_DUE | SUSPENDED | CANCELLED | EXPIRED
  billingStatus    String    @default("TRIAL")
  /// MONTHLY | ANNUAL
  billingCycle     String    @default("MONTHLY")
  /// Preço contratado mensal (preserva fundador / acordo) — fonte do MRR
  priceMonthly     Decimal?
  /// Preço contratado anual (se ciclo ANNUAL)
  priceAnnual      Decimal?
  /// Dia do vencimento mensal (1–31). Meses curtos usam o último dia válido.
  billingDueDay    Int?
  /// Créditos extras de IA (pacotes futuros)
  extraAiCredits   Int       @default(0)
  provider         String? // manual | stripe | mercadopago | asaas
  externalId       String?
  /// Próximo vencimento (fonte de verdade para atraso / "em dia")
  currentPeriodEnd DateTime?
  trialEndsAt      DateTime?
  cancelAt         DateTime?
  metadata         Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  payments         Payment[]

  @@index([billingStatus])
  @@index([planId])
  @@index([currentPeriodEnd])
}

/// Pagamento manual (Superadmin). Sem gateway na v1.
model Payment {
  id              String        @id @default(cuid())
  tenantId        String
  subscriptionId  String?
  subscription    Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  amount          Decimal
  paidAt          DateTime
  /// Período de referência (ex.: 2026-07 ou "julho/2026")
  referencePeriod String?
  /// PIX | TRANSFER | BOLETO | CARD | CASH | OTHER
  method          String?
  notes           String?
  createdBy       String?
  createdAt       DateTime      @default(now())

  @@index([tenantId, paidAt])
  @@index([subscriptionId])
  @@index([createdAt])
}

/// Pedido de demonstração vindo do site público.
/// Não pertence a um tenant até a conversão comercial.
model SalesLead {
  id          String          @id @default(cuid())
  name        String
  email       String
  phone       String?
  companyName String
  teamSize    String?
  message     String?
  source      String          @default("website")
  status      SalesLeadStatus @default(NEW)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([status, createdAt])
  @@index([email])
  @@index([createdAt])
}

/// Consumo de IA por tenant (créditos mensais)
model AiUsageLog {
  id        String   @id @default(cuid())
  tenantId  String
  agentId   String?
  provider  String?
  model     String?
  tokensIn  Int      @default(0)
  tokensOut Int      @default(0)
  /// Unidades de crédito consumidas (1 = uma resposta assistida)
  credits   Int      @default(1)
  purpose   String?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}

// ===================== ASSISTENTE NEXAFLOW (plataforma — não é agente do tenant) =====================

/// Documentação / help knowledge da PLATAFORMA (sem tenantId).
/// status: draft | published | archived — só published entra no assistente.
model HelpKnowledgeDoc {
  id             String    @id @default(cuid())
  title          String
  category       String?
  content        String
  status         String    @default("draft")
  sortOrder      Int       @default(0)
  /// seed | manual | import
  source         String    @default("manual")
  /// Chave estável do seed (upsert). Null = artigo manual.
  seedKey        String?   @unique
  /// Última revisão editorial (freshness)
  lastReviewedAt DateTime?
  /// Versão de produto associada ao conteúdo (ex.: 1.9.0)
  productVersion String?
  /// Marcado para revisão quando funcionalidade mudar
  needsReview    Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
  @@index([category])
  @@index([needsReview])
}

/// Thread curta do Assistente NexaFlow por usuário (histórico de ajuda).
model HelpAssistantThread {
  id        String                 @id @default(cuid())
  userId    String
  /// Contexto do tenant no momento da conversa (isolamento)
  tenantId  String?
  title     String?
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  messages  HelpAssistantMessage[]

  @@index([userId, updatedAt])
  @@index([tenantId])
}

model HelpAssistantMessage {
  id        String   @id @default(cuid())
  threadId  String
  /// user | assistant
  role      String
  content   String
  /// Action chips: [{ type, label, href?, action? }]
  actions   Json?
  /// up | down | null
  feedback  String?
  metadata  Json?
  createdAt DateTime @default(now())

  thread HelpAssistantThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

/// Lacunas de ajuda (perguntas sem resposta / feedback negativo) — pipeline da plataforma.
model HelpKnowledgeGap {
  id         String   @id @default(cuid())
  question   String
  userId     String?
  tenantId   String?
  route      String?
  reason     String?
  count      Int      @default(1)
  /// open | reviewed | closed
  status     String   @default("open")
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([status, lastSeenAt])
  @@index([tenantId])
}

// ===================== CHANGELOG / NOVIDADES DA PLATAFORMA =====================

/// Release pública da NexaFlow (não misturar com AuditLog / logs técnicos).
model PlatformRelease {
  id          String                @id @default(cuid())
  /// SemVer-like: 1.8.0
  version     String                @unique
  title       String
  summary     String?
  /// DRAFT | PUBLISHED | ARCHIVED
  status      String                @default("DRAFT")
  /// ALL | SUPERADMIN
  visibility  String                @default("ALL")
  publishedAt DateTime?
  createdById String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  items       PlatformReleaseItem[]
  seenBy      UserReleaseSeen[]

  @@index([status, publishedAt])
  @@index([createdAt])
}

model PlatformReleaseItem {
  id        String          @id @default(cuid())
  releaseId String
  /// NEW | IMPROVEMENT | FIX | SECURITY
  category  String
  body      String
  sortOrder Int             @default(0)
  release   PlatformRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@index([releaseId, sortOrder])
}

/// Usuário marcou release como vista (badge "Novo").
model UserReleaseSeen {
  id        String          @id @default(cuid())
  userId    String
  releaseId String
  seenAt    DateTime        @default(now())
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  release   PlatformRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@unique([userId, releaseId])
  @@index([userId])
  @@index([releaseId])
}
