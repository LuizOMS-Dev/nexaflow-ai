{
  "name": "@nexaflow/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json --pretty false",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "security:check": "tsx src/scripts/security-check.ts",
    "db:cleanup-fixtures": "tsx src/scripts/cleanup-test-fixtures.ts",
    "db:cleanup-fixtures:apply": "tsx src/scripts/cleanup-test-fixtures.ts --apply",
    "db:list-tenants": "tsx src/scripts/list-tenants.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.1",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/jwt": "^10.2.0",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^10.1.0",
    "@fastify/websocket": "^11.0.2",
    "@nexaflow/db": "*",
    "@prisma/client": "^6.5.0",
    "@whiskeysockets/baileys": "^7.0.0-rc13",
    "argon2": "^0.44.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "file-type": "^21.3.4",
    "ioredis": "^5.11.1",
    "openai": "^4.89.0",
    "otplib": "^13.4.1",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.10",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^4.1.10"
  }
}
