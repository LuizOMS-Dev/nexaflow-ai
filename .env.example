# App
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=NexaFlow
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_PUBLIC_URL=http://localhost:3000
API_URL=http://localhost:4000
API_HOST=0.0.0.0
API_PORT=4000
CORS_ORIGIN=http://localhost:3000

# Database / Redis
DATABASE_URL=postgresql://postgres:CHANGE_ME_LOCAL_ONLY@localhost:5432/nexaflow?schema=public
REDIS_URL=redis://localhost:6379

# Auth (troque em qualquer ambiente compartilhado)
JWT_SECRET=CHANGE_ME_GENERATE_RANDOM_64_CHARS
JWT_EXPIRES_IN=15m
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
COOKIE_SECRET=CHANGE_ME_GENERATE_RANDOM_64_CHARS
ENCRYPTION_KEY=CHANGE_ME_GENERATE_RANDOM_64_CHARS
AUTH_LOGIN_MAINTENANCE=0

# Seed do primeiro superadmin
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
SEED_SUPERADMIN_NAME=Super Admin

# IA (prioridade: Groq -> xAI -> OpenAI)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
XAI_API_KEY=
XAI_MODEL=grok-3-mini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# WhatsApp
# baileys (embutido) | evolution | waha | simulated
WA_GATEWAY_PROVIDER=baileys
WA_GATEWAY_URL=
WA_GATEWAY_API_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# E-mail
MAIL_PROVIDER=log
MAIL_API_KEY=
MAIL_FROM=NexaFlow <noreply@localhost>
SALES_EMAIL=

# Storage
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
WA_SESSIONS_DIR=
