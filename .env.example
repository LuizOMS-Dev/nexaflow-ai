# ===== NexaFlow AI — Variáveis de ambiente =====
# Copie para .env e ajuste. Nunca commitar secrets reais.
# Docker Compose injeta a maioria; este arquivo documenta o contrato.

# ─── Runtime ───
# development | production | test
NODE_ENV=development

# ─── Database (OBRIGATÓRIO produção: Postgres) ───
DATABASE_URL="postgresql://nexaflow:nexaflow@localhost:5432/nexaflow?schema=public"
# DATABASE_URL_TEST="postgresql://nexaflow:nexaflow@localhost:5432/nexaflow?schema=nexaflow_test"

# ─── Redis (OBRIGATÓRIO produção) ───
REDIS_URL="redis://localhost:6379"
# RATE_LIMIT_REDIS=1          # força Redis
# RATE_LIMIT_REDIS=0          # desliga (prod exige ALLOW_MEMORY_RATE_LIMIT=1 — inseguro)
# ALLOW_MEMORY_RATE_LIMIT=1

# ─── API ───
API_PORT=4000
API_HOST=0.0.0.0
# URL pública da API (webhooks externos / docs)
API_URL="http://localhost:4000"
# URL interna Docker (Evolution → API). Obrigatória em compose.
# INTERNAL_API_URL=http://api:4000
# Front público (links de convite / reset). PRODUÇÃO: https://app.dominio.com
APP_PUBLIC_URL="http://localhost:3000"
# CSV de origins. PRODUÇÃO: https://app.dominio.com (sem * e sem localhost)
CORS_ORIGIN="http://localhost:3000"
# true | false | loopback | CIDR. EasyPanel: true ou IP do proxy
TRUST_PROXY=true

# ─── Secrets (OBRIGATÓRIOS produção: fortes, únicos, ≥32) ───
JWT_SECRET="altere-este-segredo-super-forte-em-producao-min-32"
COOKIE_SECRET="altere-cookie-secret-forte-em-producao-min-24"
ENCRYPTION_KEY="altere-encryption-key-32-chars-min!!"
JWT_EXPIRES_IN=15m
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
JWT_ISSUER=nexaflow-api
JWT_AUDIENCE=nexaflow-web

# Superadmin MFA. Produção: 1 (default se NODE_ENV=production)
SUPERADMIN_MFA_REQUIRED=0

# ─── Web (Next) ───
NEXT_PUBLIC_API_URL="/nexa-api"
NEXT_PUBLIC_APP_NAME="NexaFlow AI"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WS_URL="ws://localhost:4000/ws"

# ─── IA (opcional; prioridade GROQ → XAI → OPENAI) ───
GROQ_API_KEY=
GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_MODEL="llama-3.1-8b-instant"
XAI_API_KEY=
XAI_BASE_URL="https://api.x.ai/v1"
XAI_MODEL="grok-4.5"
OPENAI_API_KEY=
OPENAI_MODEL="gpt-4o-mini"
AI_MODEL=

# ─── WhatsApp gateway ───
WA_GATEWAY_PROVIDER=evolution
WA_GATEWAY_URL=http://localhost:8080
WA_GATEWAY_API_KEY=nexaflow-evolution-key
EVOLUTION_API_KEY=nexaflow-evolution-key
EVOLUTION_SERVER_URL=http://localhost:8080
WA_MAX_SEND_PER_CHANNEL_MIN=60
WA_MAX_SEND_PER_RECIPIENT_MIN=8
CAMPAIGN_BATCH_LIMIT=100
# Sessões Baileys (volume). Produção Docker: /app/data/wa-sessions
WA_SESSIONS_DIR=

# Meta Cloud (opcional / legado)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=nexaflow-verify-token

# ─── E-mail ───
# log = console (dev) | none = não envia | resend = produção
MAIL_PROVIDER=log
MAIL_API_KEY=
# RESEND_API_KEY=
MAIL_FROM="NexaFlow <onboarding@resend.dev>"
SALES_EMAIL=
# Canal real exibido pela NIA/branding. Não use endereço fictício.
NEXAFLOW_SUPPORT_EMAIL=
RUN_SEED_ON_BOOT=0

# ─── Storage ───
STORAGE_DRIVER=local
# Produção Docker: /app/uploads
STORAGE_LOCAL_PATH=./uploads

# ─── Seed manual (credenciais obrigatórias; nunca há senha padrão) ───
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
SEED_SUPERADMIN_NAME="Super Admin"
SEED_CREATE_TENANT=0
SEED_COMPANY_NAME="Minha Empresa"
SEED_TENANT_SLUG="minha-empresa"
SEED_WIPE_ALL=0
# SEED_DEMO_ENABLED=true

# ─── Produção (checklist mínimo) ───
# NODE_ENV=production
# SUPERADMIN_MFA_REQUIRED=1
# DATABASE_URL=postgresql://...
# REDIS_URL=redis://...
# CORS_ORIGIN=https://app.seudominio.com
# APP_PUBLIC_URL=https://app.seudominio.com
# API_URL=https://api.seudominio.com
# JWT_SECRET=... COOKIE_SECRET=... ENCRYPTION_KEY=...
# MAIL_PROVIDER=resend
# MAIL_API_KEY=re_...
# TRUST_PROXY=true
# ALLOW_DEMO_ACCOUNTS=0
